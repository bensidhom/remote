# Elastic Beanstalk (Python platform, Amazon Linux 2/2023) configuration for the
# BridgeGuard backend. Deploy the backend/ directory as the application root
# AFTER running build.ps1 / build.sh (so backend/static/ holds the built SPA).
# On the Python platform, the included Procfile launches the app:
#   web: gunicorn -k uvicorn.workers.UvicornWorker app.main:app ...
#
# Set secrets/config as EB environment properties (Console -> Configuration ->
# Software -> Environment properties), NOT here. Typical keys:
#   CEREBRAS_API_KEY, NVIDIA_API_KEY, CEREBRAS_MODEL, NVIDIA_VLM_MODEL,
#   NVIDIA_EMBED_MODEL, BRIDGEGUARD_AI_PROVIDER, BRIDGEGUARD_DATA_DIR
#
# Uncomment to pin non-secret defaults at the platform level:
#
# option_settings:
#   aws:elasticbeanstalk:application:environment:
#     BRIDGEGUARD_AI_PROVIDER: cerebras
