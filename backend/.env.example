# ============================================================================
# BridgeGuard backend environment.
# Copy this file to backend/.env and fill in real values (backend/.env is
# gitignored). In production, store secrets in a root-readable server env file;
# real environment variables override this file.
# ============================================================================

# ---- Cerebras generation (text + vision) ----

# Cerebras is the DEFAULT provider for text AND image (multimodal chat) AND for
# RAG knowledge-graph completion. Key from cloud.cerebras.ai.
CEREBRAS_API_KEY=csk-your-cerebras-key-here
# Cerebras model id used for chat + vision + RAG completion.
CEREBRAS_MODEL=qwen-3.8-27b
# Optional explicit multimodal/point-cloud model. Keep this on Qwen when set;
# otherwise the application now defaults vision work to Qwen as well.
CEREBRAS_VISION_MODEL=qwen-3.8-27b
BRIDGETTE_CEREBRAS_MODEL=gpt-oss-120b
# Bridgette sees the actual bridge projection tables and columns, enriched with
# SNBI descriptions and legacy mappings. Internal/private tables stay excluded.
BRIDGEGUARD_QUERY_MODE=hybrid
# Query-engine rollout: legacy keeps the existing routed planner, shadow runs
# the full-context agentic path without changing the visible answer, and agentic
# makes that path user-visible. Aliases off/legacy and on/agentic are accepted.
BRIDGETTE_QUERY_ENGINE=agentic
# Preserve Bridgette's hosted natural-language response even when structured
# claim annotations are incomplete; SQL execution remains sandboxed/read-only.
BRIDGETTE_ANSWER_VALIDATION=advisory
# Cerebras OpenAI-compatible base URL (used by the RAG/LightRAG completion path).
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Qwen defaults to high reasoning at Cerebras. The app explicitly sends `none`
# when this is blank so short completion budgets still return an answer. Set
# low|medium|high only when the call has a sufficiently large token budget.
# CEREBRAS_REASONING_EFFORT=

# ---- Dedicated commercial entitlement evidence ----
# Required only for a production `dedicated_customer` deployment. These values
# are server-side references to completed operator/legal/procurement records;
# they are a launch interlock, not proof or self-attestation of legal clearance.
# Do not use placeholders, filesystem paths, contract text, credentials, or
# secrets as receipt IDs. Keep the non-secret provider/model IDs aligned with
# the actual runtime configuration above.
# BRIDGEGUARD_PDF_ENGINE_DISPOSITION=permissive_replacement
# Allowed: permissive_replacement | commercial_license | approved_agpl_compliance
# BRIDGEGUARD_PDF_ENGINE_RECEIPT_ID=replace-pdf-review-receipt
# BRIDGEGUARD_AI_PROVIDER_ID=cerebras
# BRIDGEGUARD_AI_MODEL_ID=qwen-3.8-27b
# BRIDGEGUARD_AI_PROVIDER_ENTITLEMENT_RECEIPT_ID=replace-ai-entitlement-receipt
# BRIDGEGUARD_AI_DPA_RECEIPT_ID=replace-ai-dpa-receipt
# Choose the mode actually built into the frontend. A keyless OSM basemap still
# needs a reviewed provider/tile-use/attribution policy; it is not a free-for-all.
# BRIDGEGUARD_MAP_SERVICE_MODE=arcgis_sdk_keyless_osm
# Allowed: arcgis_premium | arcgis_sdk_keyless_osm
# BRIDGEGUARD_MAP_SERVICE_RECEIPT_ID=replace-map-policy-receipt
# BRIDGEGUARD_CLOUDFLARE_SERVICE_RECEIPT_ID=replace-cloudflare-service-receipt
# BRIDGEGUARD_OSS_NOTICES_RECEIPT_ID=replace-oss-notices-receipt
# BRIDGEGUARD_SBOM_RECEIPT_ID=replace-release-sbom-receipt

# ---- Pinned Nomic embeddings (Hugging Face TEI; no Ollama) ----
# Compose sets these values automatically. Keep the model, full revision,
# dimensions, normalization, and query/document prefix policy together.
TEI_EMBED_BASE_URL=http://embeddings:80
TEI_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
TEI_EMBED_REVISION=20d1e6057a2e1fa08b45123e41ce9381fc338f0e
TEI_EMBED_DIM=768
TEI_RUNTIME_VERSION=1.9.3
# Optional bearer token if TEI is exposed behind an authenticated proxy.
# TEI_EMBED_API_KEY=
# Re-embed any migrated/stale report caches in one background thread at startup.
BRIDGEGUARD_REINDEX_STALE_REPORTS=1

# ---- Paths ----

# Root folder for ALL persistent app data (DBs, attachments, RAG storage, temp).
# Defaults to backend/data (self-contained). Point at a writable/persistent dir
# on the server (for example, an attached persistent block volume).
# BRIDGEGUARD_DATA_DIR=/var/app/current/backend/data

# Override just the RAG working dir (embeddings/images/KG). Defaults under data/.
# RAG_WORKING_DIR=

# Location of the built frontend to serve. Defaults to the first existing of
# backend/static then frontend/dist. Set explicitly if staged elsewhere.
# FRONTEND_DIST=

# ---- Server ----

# Server-enforced MVP authentication. Generate the session secret with:
#   openssl rand -base64 48
BRIDGEGUARD_AUTH_MODE=password
BRIDGEGUARD_SESSION_SECRET=replace-with-at-least-32-random-characters
BRIDGEGUARD_PASSWORD=replace-with-a-long-unique-password
BRIDGEGUARD_OWNER_EMAIL=bsidhom.ahmed@gmail.com
BRIDGEGUARD_ADMIN_EMAILS=
BRIDGEGUARD_EDITOR_EMAILS=douglas.tintle@dot.nj.gov,vijay.sampat@dot.nj.gov,harjit.bal@dot.nj.gov,mantawy@rowan.edu,bahria76@rowan.edu
# Leave both viewer settings empty while access is limited to the owner and
# five editors. A domain here would authorize every user in that domain.
BRIDGEGUARD_ALLOWED_EMAILS=
BRIDGEGUARD_ALLOWED_DOMAINS=
BRIDGEGUARD_SESSION_TTL_SECONDS=28800
# Production HTTPS deployments must keep this true.
BRIDGEGUARD_ENV=production
BRIDGEGUARD_COOKIE_SECURE=true
# Local development escape hatch only; never enable in a deployed environment.
# BRIDGEGUARD_AUTH_DISABLED=1
# Cloudflare Access production mode replaces the shared password login. Copy the
# team domain and application AUD tag from Zero Trust > Access > Applications.
# BRIDGEGUARD_AUTH_MODE=cloudflare
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=replace-with-application-aud-tag
# Maximum size accepted for any uploaded file.
BRIDGEGUARD_MAX_UPLOAD_MB=50
# Hard ceiling for each content-addressed source-artifact store. New unique
# bytes and their manifest fail closed before acceptance when this limit would
# be exceeded; deduplicated objects are counted once. Size this below the
# dedicated volume alert threshold and monitor free disk independently.
BRIDGEGUARD_SOURCE_ARTIFACT_STORE_MAX_BYTES=10737418240

# Standalone PDF Ask limits. These are operator-owned safety ceilings; clients
# cannot increase them in requests. The upload byte limit also drives the
# pre-multipart transport guard (with 2 MiB reserved for form overhead).
BRIDGEGUARD_DOCUMENT_MAX_UPLOAD_BYTES=52428800
BRIDGEGUARD_PDF_MAX_PAGES=300
BRIDGEGUARD_PDF_MAX_EMBEDDED_IMAGES=512
BRIDGEGUARD_PDF_MAX_PAGE_PIXELS=24000000
BRIDGEGUARD_PDF_MAX_TOTAL_RENDER_PIXELS=500000000
BRIDGEGUARD_PDF_MAX_EXTRACTED_TEXT_CHARS=5000000
BRIDGEGUARD_PDF_MAX_DERIVATIVE_BYTES=268435456
BRIDGEGUARD_DERIVATIVE_RESPONSE_MAX_IMAGES=8
BRIDGEGUARD_DERIVATIVE_RESPONSE_MAX_BYTES=12582912
BRIDGEGUARD_DERIVATIVE_RESPONSE_MAX_SINGLE_BYTES=6291456
BRIDGEGUARD_DOCUMENT_QUERY_CONTEXT_MAX_CHARS=160000

# Point-cloud uploads are streamed to disk and have a separate limit. JSON/binary
# analysis requests remain bounded because they are held in memory during processing.
BRIDGEGUARD_MAX_POINT_CLOUD_MB=500
BRIDGEGUARD_MAX_POINT_BODY_MB=128
# Rollout gate: local/research defaults to legacy_research. Production or a
# dedicated_customer defaults to required and refuses the legacy research
# implementation. hardened_shadow/required become executable only as the
# replacement pipeline lands; until then they return a typed 503 rather than
# silently falling back.
POINT_CLOUD_PIPELINE_MODE=required
# Dedicated/commercial publication fails closed unless this receipt is present,
# hash-valid, release_passed, blocker-free, and bound to the exact active code,
# parser, geometry, fusion, measurement, prompt, model and context versions.
# The bundled synthetic safety corpus cannot produce a passing release receipt;
# registered survey ground truth and domain-approved thresholds are still needed.
BRIDGEGUARD_POINT_CLOUD_REQUIRE_EVALUATION=false
# BRIDGEGUARD_POINT_CLOUD_EVALUATION_RECEIPT=/data/evaluation/point_cloud_release_receipt.json

# Port the app binds to (Procfile / uvicorn read this). Defaults to 8000.
# PORT=8000

# CORS allowlist for split-origin deployments. Leave empty for the recommended
# same-origin deployment. Never use "*" with cookie authentication.
# CORS_ORIGINS=https://bridgeguard.example.com
