# ============================================================================
# BridgeGuard backend environment.
# Copy this file to backend/.env and fill in real values (backend/.env is
# gitignored). On AWS prefer setting these as real environment variables
# (Elastic Beanstalk env properties / EC2 shell) — real env vars override .env.
# ============================================================================

# ---- Hosted LLM providers (both are multimodal: text + image) ----

# Cerebras is the DEFAULT provider for text AND image (multimodal chat) AND for
# RAG knowledge-graph completion. Key from cloud.cerebras.ai.
CEREBRAS_API_KEY=csk-your-cerebras-key-here
# Cerebras model id used for chat + vision + RAG completion.
CEREBRAS_MODEL=gemma-4-31b
# Cerebras OpenAI-compatible base URL (used by the RAG/LightRAG completion path).
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# reasoning_effort: OFF by default. On reasoning models the hidden reasoning can
# consume the token budget and return an EMPTY answer. Opt in with low|medium|high
# (and raise the token budget). Leave blank/none/off to disable.
# CEREBRAS_REASONING_EFFORT=

# NVIDIA (build.nvidia.com) is the ALTERNATIVE chat/vision + RAG-completion
# provider. It is ALSO the ONLY embeddings provider: RAG document embeddings
# ALWAYS use NVIDIA regardless of the chat provider, because Cerebras exposes no
# embeddings endpoint and "no local inference" rules out a local embed model.
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
# NVIDIA vision-language model (handles text + images).
NVIDIA_VLM_MODEL=qwen/qwen3.5-397b-a17b
# Optional: separate (e.g. cheaper) NVIDIA model for text-only stages.
# Defaults to NVIDIA_VLM_MODEL when unset.
NVIDIA_TEXT_MODEL=
# NVIDIA embedding model used for RAG indexing. NVIDIA_EMBED_DIM MUST match the
# model's output dim (nv-embedqa-e5-v5 = 1024). Changing the model requires
# deleting old data/rag_storage/kg_* stores (a vector store is dim-locked).
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# NVIDIA_EMBED_DIM=1024

# Which provider serves chat/vision by default: "cerebras" or "nvidia".
# Also switchable at runtime in Settings (POST /api/ai-provider).
BRIDGEGUARD_AI_PROVIDER=cerebras

# ---- Paths ----

# Root folder for ALL persistent app data (DBs, attachments, RAG storage, temp).
# Defaults to backend/data (self-contained). Point at a writable/persistent dir
# on the server (e.g. an attached EBS/EFS volume) for production.
# BRIDGEGUARD_DATA_DIR=/var/app/current/backend/data

# Override just the RAG working dir (embeddings/images/KG). Defaults under data/.
# RAG_WORKING_DIR=

# Location of the built frontend to serve. Defaults to the first existing of
# backend/static then frontend/dist. Set explicitly if staged elsewhere.
# FRONTEND_DIST=

# ---- Server ----

# Server-enforced MVP authentication. Generate the session secret with:
#   openssl rand -base64 48
BRIDGEGUARD_AUTH_MODE=password
BRIDGEGUARD_SESSION_SECRET=replace-with-at-least-32-random-characters
BRIDGEGUARD_PASSWORD=replace-with-a-long-unique-password
BRIDGEGUARD_ADMIN_EMAILS=admin@example.com
BRIDGEGUARD_EDITOR_EMAILS=editor@example.com
BRIDGEGUARD_ALLOWED_EMAILS=viewer@example.com
BRIDGEGUARD_ALLOWED_DOMAINS=dot.nj.gov
BRIDGEGUARD_SESSION_TTL_SECONDS=28800
# Production HTTPS deployments must keep this true.
BRIDGEGUARD_ENV=production
BRIDGEGUARD_COOKIE_SECURE=true
# Local development escape hatch only; never enable in a deployed environment.
# BRIDGEGUARD_AUTH_DISABLED=1
# Cloudflare Access production mode replaces the shared password login. Copy the
# team domain and application AUD tag from Zero Trust > Access > Applications.
# BRIDGEGUARD_AUTH_MODE=cloudflare
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=replace-with-application-aud-tag
# Maximum size accepted for any uploaded file.
BRIDGEGUARD_MAX_UPLOAD_MB=50

# Port the app binds to (Procfile / uvicorn read this). Defaults to 8000.
# PORT=8000

# CORS allowlist for split-origin deployments. Leave empty for the recommended
# same-origin deployment. Never use "*" with cookie authentication.
# CORS_ORIGINS=https://bridgeguard.example.com
