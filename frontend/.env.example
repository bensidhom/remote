# Frontend environment variables (Vite). Copy to .env.local to use.

# Optional: ArcGIS API key. Leave unset to use free, keyless basemaps
# (OpenStreetMap for streets, Esri World Imagery for satellite).
# Set it to unlock premium ArcGIS basemaps (arcgis/navigation, arcgis/imagery).
# VITE_ARCGIS_API_KEY=
# The same key enables the bridge Site Intelligence imagery map and live traffic
# layer in the browser. Keep URL/referrer restrictions enabled in ArcGIS.

# Backend proxy target (defaults to http://127.0.0.1:5000)
# VITE_BACKEND_URL=http://127.0.0.1:5000
# VITE_BACKEND_PORT=5000
